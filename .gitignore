# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv
venv/
.env

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Data files (keep directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Trained model artifacts
models/*
!models/.gitkeep

# Generated reports & metrics
reports/figures/*
!reports/figures/.gitkeep
reports/metrics/*
!reports/metrics/.gitkeep

# Local database files
*.db
*.sqlite
*.sqlite3
